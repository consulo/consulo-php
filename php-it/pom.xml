<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>consulo</groupId>
        <artifactId>arch.bind.java</artifactId>
        <version>3-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>consulo.plugin</groupId>
    <artifactId>consulo.php-php.it</artifactId>
    <version>3-SNAPSHOT</version>

    <!--
      Integration tests in a headless application with real projects, indexes and write actions, modelled on consulo's
      modules/it. Test sources only and no module-info.java: the headless harness discovers @ExtensionImpl/@ServiceImpl
      bindings through a classpath ServiceLoader, which skips providers in named modules. Nothing here ships.
    -->
    <repositories>
        <repository>
            <id>consulo</id>
            <url>https://maven.consulo.dev/repository/snapshots/</url>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>interval:60</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- the headless application, projects and modules -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-it</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- the PHP modules compile against each other with the provided scope, the test classpath has to carry them -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.php-php.api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.php</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.php-xdebug.impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.php-composer.impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- provided in php-impl: PHP files are HTML templates -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>com.intellij.xml</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- composer-impl registers composer.json through the JSON plugin -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.json.api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- the external system import of composer.json sets the compiler paths of the modules it creates -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-compiler-impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- composer-impl reads composer.json through its JOM model -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>consulo.json.jom.api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- needed by the XML plugin at runtime -->
        <dependency>
            <groupId>consulo</groupId>
            <artifactId>consulo-util-xml-fast-reader</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.6</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
